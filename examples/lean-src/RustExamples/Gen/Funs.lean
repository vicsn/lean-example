    Source: 'examples/src/nsl.rs', lines 420:0-427:1 -/
def nsl.concretize
  (m : nsl.Msg nsl.Sym) : RustM (Option (nsl.Msg Std.U64)) := do
  match m with
  | nsl.Msg.One s x =>
    match s with
    | nsl.Sym.Val a => ok (some (nsl.Msg.One a x))
    | nsl.Sym.Secret => ok none
  | nsl.Msg.Two s s1 x =>
    match s with
    | nsl.Sym.Val a =>
      match s1 with
      | nsl.Sym.Val b => ok (some (nsl.Msg.Two a b x))
      | nsl.Sym.Secret => ok none
    | nsl.Sym.Secret => ok none
  | nsl.Msg.Three s =>
    match s with
    | nsl.Sym.Val a => ok (some (nsl.Msg.Three a))
    | nsl.Sym.Secret => ok none

