  {C : Type _} (coremarkerCopyInst : core.marker.Copy C) (corecmpEqInst :
  core.cmp.Eq C) (a : Slice (nsl.Response C)) (b : Slice (nsl.Response C)) :
  RustM Bool
  := do
  let i := Slice.len a
  let i1 := Slice.len b
  if i != i1
  then ok false
  else nsl.same_responses_loop coremarkerCopyInst corecmpEqInst a b 0#usize

